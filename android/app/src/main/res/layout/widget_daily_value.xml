<?xml version="1.0" encoding="utf-8"?>
<!--
  Daily Value Widget - 紧凑布局（2×2）【2.18.0 Widget V2 Visual Refresh】
  结构：
    每日的价值          9月
    本月支出
    ¥3,268.50
    收入 ¥8,600     结余 ¥5,331.50
  所有颜色由 Provider 按 Theme（resolvedTheme/themeStyle/accentColor）动态设置，
  不再固定深色 / 固定 ¥；支出保持绿色、收入保持红色、结余中性。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_light"
    android:gravity="center_vertical"
    android:padding="@dimen/widget_padding">

    <!-- 顶行：标题（左） + 月份（右，弱化） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="每日的价值"
            android:textColor="@color/dv_widget_title"
            android:textSize="@dimen/widget_title_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="9月"
            android:textColor="@color/dv_widget_label"
            android:textSize="@dimen/widget_label_size" />
    </LinearLayout>

    <!-- 次级说明：本月支出 -->
    <TextView
        android:id="@+id/widget_month_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:text="本月支出"
        android:textColor="@color/dv_widget_label"
        android:textSize="@dimen/widget_label_size" />

    <!-- 主数字：本月支出金额（最大字号，支出绿） -->
    <TextView
        android:id="@+id/widget_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="¥0.00"
        android:textColor="@color/dv_widget_expense"
        android:textSize="@dimen/widget_amount_size"
        android:textStyle="bold" />

    <!-- 底部：收入（左，红） | 结余（右，中性），不再重复显示支出 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="收入"
                android:textColor="@color/dv_widget_label"
                android:textSize="@dimen/widget_sub_size" />

            <TextView
                android:id="@+id/widget_income"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="¥0.00"
                android:textColor="@color/dv_widget_income"
                android:textSize="@dimen/widget_sub_size"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="结余"
                android:textColor="@color/dv_widget_label"
                android:textSize="@dimen/widget_sub_size" />

            <TextView
                android:id="@+id/widget_balance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="¥0.00"
                android:textColor="@color/dv_widget_balance"
                android:textSize="@dimen/widget_sub_size"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>