android/app/build/
android/build/
android/.gradle/
android/.idea/
.gradle/
build/

# 交付产物（不入库，由打包脚本生成）
review-build/
*.zip

# 交付暂存目录（含 APK/ZIP/截图等二进制，不入库；最终 Handoff 以 handoff/ 为准）
/.delivery/

